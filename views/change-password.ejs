<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Choose your password</title>
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body class="center-page">
  <main class="card" style="max-width:460px; margin:10vh auto; padding:28px;">
    <p class="eyebrow">Account security</p>
    <h1>Choose your own password</h1>
    <p>The password provided by your administrator is temporary. Choose a private password before continuing.</p>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <form class="form stack" method="post" action="/account/change-password">
      <label>Current password<input type="password" name="current_password" autocomplete="current-password" required /></label>
      <label>New password<input type="password" name="new_password" autocomplete="new-password" minlength="12" required /></label>
      <label>Confirm new password<input type="password" name="confirm_password" autocomplete="new-password" minlength="12" required /></label>
      <button class="btn" type="submit">Save new password</button>
    </form>
  </main>
</body>
</html>
