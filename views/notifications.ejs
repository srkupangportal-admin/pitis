<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Notifications</title><link rel="stylesheet" href="/css/theme-c.css"></head><body><%- include('partials/main-header-card') %><main class="container"><section class="card"><div class="notification-heading"><div><h2>Notifications</h2><p class="muted">Updates and reminders remain here after device alerts disappear.</p></div><button class="btn secondary" id="markAll">Mark all read</button></div><div id="notificationList">Loading…</div><button class="btn secondary" id="loadMore" hidden>Load more</button></section></main><script src="/js/notifications.js"></script><script>let before=null;async function load(reset=true){const data=await PortalNotifications.json('/api/notifications?limit=30'+(!reset&&before?'&before='+before:''));const list=document.getElementById('notificationList');if(reset)list.innerHTML='';for(const n of data.items){const a=document.createElement('a');a.className='notification-item '+(n.read_at?'':'unread');a.href=n.url;a.innerHTML='<strong></strong><span></span><small></small>';a.querySelector('strong').textContent=n.title;a.querySelector('span').textContent=n.message;a.querySelector('small').textContent=new Date(n.created_at).toLocaleString();a.onclick=()=>fetch('/api/notifications/'+n.id+'/read',{method:'PATCH',headers:{'content-type':'application/json'},body:'{}'});list.appendChild(a)}if(!data.items.length&&reset)list.textContent='No notifications yet.';before=data.items.at(-1)?.id;document.getElementById('loadMore').hidden=data.items.length<30}document.getElementById('markAll').onclick=async()=>{await PortalNotifications.json('/api/notifications/mark-all-read',{method:'POST',body:'{}'});load()};document.getElementById('loadMore').onclick=()=>load(false);load()</script></body></html>
