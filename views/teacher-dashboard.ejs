<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Staff Dashboard</title>
  <link rel="stylesheet" href="/css/theme-c.css" />
</head>
<body>
  <header class="site-header">
    <h1>Staff Panel</h1>
    <span>Welcome, <%= user.displayName %></span>
  </header>
  <%- include('partials/teacher-nav') %>
  <main class="container">
    <% if (pitisProgress && pitisProgress.currentTeacher) { const progress = pitisProgress.currentTeacher; %>
      <section class="card dashboard-pitis-card" id="pitis-progress" aria-labelledby="pitisProgressTitle">
        <div class="dashboard-pitis-heading">
          <div>
            <span class="teacher-progress-kicker"><%= pitisProgress.weekNumber ? ('Week ' + pitisProgress.weekNumber + ' · Term ' + pitisProgress.term) : ('Term ' + pitisProgress.term) %></span>
            <h2 id="pitisProgressTitle">Your PITIS progress</h2>
            <p class="muted"><%= pitisProgress.weekRange %></p>
          </div>
          <div class="teacher-progress-ring dashboard-pitis-ring" style="--progress: <%= Math.max(0, Math.min(100, progress.percentage)) %>">
            <strong><%= progress.percentage %>%</strong><span>weekly target</span>
          </div>
        </div>
        <div class="dashboard-pitis-stats">
          <div><strong><%= progress.activeDays %>/<%= progress.requiredDays %></strong><span>target days</span></div>
          <div><strong><%= progress.pointsAwarded %></strong><span>PITIS awarded</span></div>
          <div><strong>#<%= progress.rank %></strong><span>of <%= pitisProgress.teachers.length %> teachers</span></div>
          <div><strong><%= pitisProgress.schoolConsistency %>%</strong><span>school consistency</span></div>
        </div>
        <div class="teacher-progress-weekdays" aria-label="Your PITIS activity by school day">
          <% progress.days.forEach(function(day) { const state = day.counted ? 'met' : (day.type !== 'school_day' ? 'excluded' : (day.isFuture ? 'future' : 'not-met')); %>
            <div class="teacher-progress-day is-<%= state %> <%= day.isToday ? 'is-today' : '' %>">
              <span class="teacher-progress-day-name"><%= day.shortLabel %></span>
              <span class="teacher-progress-day-check" aria-hidden="true"><%= day.counted ? '✓' : (day.type !== 'school_day' ? '—' : '○') %></span>
              <small><%= day.counted ? 'Done' : (day.type !== 'school_day' ? 'Excluded' : (day.isFuture ? 'Upcoming' : 'Not yet')) %></small>
            </div>
          <% }) %>
        </div>
        <div class="dashboard-pitis-actions">
          <strong><%= progress.requiredDays <= 0 ? 'No weekly target is active today.' : (progress.activeDays >= progress.requiredDays ? 'Weekly target met.' : (Math.max(0, progress.requiredDays - progress.activeDays) + ' more active day' + (Math.max(0, progress.requiredDays - progress.activeDays) === 1 ? '' : 's') + ' needed this week.')) %></strong>
          <a class="btn" href="/teacher/reporting-tool/sip-pitis?term=<%= pitisProgress.term %>">View full progress</a>
        </div>
      </section>
    <% } %>
    <div class="cards-3">
      <a class="card action-card" href="/">Home</a>
      <a class="card action-card" href="/teacher/reward">P.I.T.I.S</a>
      <a class="card action-card" href="/rewards">P.I.T.I.S Gallery</a>
      <a class="card action-card" href="/teacher/calendar">Calendar</a>
      <a class="card action-card" href="/teacher/students">Student details</a>
      <a class="card action-card" href="/teacher/attendance">Attendance</a>
      <a class="card action-card" href="/teacher/qr-tools">QR Tools</a>
      <a class="card action-card" href="/devices">Device bookings</a>
      <a class="card action-card" href="/teacher/tools">Tools</a>
      <a class="card action-card" href="/notes">Notes</a>
      <a class="card action-card" href="/informations">Informations</a>
      <a class="card action-card" href="/photos-upload">Photos Upload</a>
    </div>
  </main>
  <script src="/js/inactivity.js"></script>
</body>
</html>

