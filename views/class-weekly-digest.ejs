<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Class Weekly PITIS Digest</title><link rel="stylesheet" href="/css/theme-c.css"></head>
<body>
  <%- include('partials/teacher-nav') %>
  <main class="container stack phase-four-report-page">
    <div class="calendar-header-row report-header-row"><div><span class="reporting-tool-menu-kicker">Phase 4 · Class record</span><h2>Class PITIS Digest</h2><p class="muted">A concise review of class recognition, deductions, reasons, and teacher participation.</p></div><div class="button-row"><a class="btn secondary" href="/teacher/reporting-tool">Reporting Tool</a><% if (report.hasClass && !report.error) { %><a class="btn secondary" href="/teacher/reporting-tool/class-digest/export.csv?classId=<%= report.classId %>&from=<%= report.from %>&to=<%= report.to %>">Download CSV</a><% } %><button class="btn" type="button" onclick="window.print()">Print / Save PDF</button></div></div>
    <form class="card form phase-four-filter" method="get" action="/teacher/reporting-tool/class-digest"><label class="phase-four-wide-field">Class<select name="classId" required><option value="">Select class</option><% report.classes.forEach(function(item) { %><option value="<%= item.id %>" <%= Number(report.classId) === item.id ? 'selected' : '' %>><%= item.name %></option><% }) %></select></label><label>From<input type="date" name="from" value="<%= report.from %>" required></label><label>To<input type="date" name="to" value="<%= report.to %>" required></label><button class="btn" type="submit">Generate Digest</button></form>
    <% if (report.error) { %><section class="card"><h3>Digest could not be generated</h3><p><%= report.error %></p></section><% } %>
    <% if (!report.hasClass && !report.error) { %><section class="card phase-four-empty"><h3>Select a class</h3><p class="muted">Choose a class and reporting dates above to generate its digest.</p></section><% } %>
    <% if (report.hasClass && !report.error) { %>
      <section class="card statement-identity"><div><span class="reporting-tool-menu-kicker">Class</span><h3><%= report.selectedClass.name %></h3><p class="muted"><%= report.from %> to <%= report.to %></p></div><div><span>Generated <%= report.generatedAt %></span></div></section>
      <section class="phase-four-kpi-grid"><article class="card"><strong><%= report.summary.coverage %>%</strong><span>Recognition coverage</span></article><article class="card"><strong><%= report.summary.recognised %>/<%= report.summary.students %></strong><span>Students recognised</span></article><article class="card"><strong><%= report.summary.notRecognised %></strong><span>Not recognised</span></article><article class="card"><strong>+<%= report.summary.awarded %></strong><span>PITIS awarded</span></article><article class="card"><strong>-<%= report.summary.deducted %></strong><span>PITIS deducted</span></article></section>
      <section class="phase-four-two-column">
        <article class="card"><div class="report-section-heading"><span class="reporting-tool-menu-kicker">Daily trend</span><h3>Activity by Day</h3></div><% if (!report.dailyRows.length) { %><p class="muted">No PITIS activity in this period.</p><% } else { %><div class="table-wrap"><table class="data-table"><thead><tr><th>Date</th><th>Students</th><th>Awards</th><th>PITIS</th><th>Deductions</th></tr></thead><tbody><% report.dailyRows.forEach(function(row) { %><tr><td><%= row.date %></td><td><%= row.students %></td><td><%= row.awards %></td><td><%= row.positivePoints %></td><td><%= row.deductions %></td></tr><% }) %></tbody></table></div><% } %></article>
        <article class="card"><div class="report-section-heading"><span class="reporting-tool-menu-kicker">Participation</span><h3>Teachers Recording PITIS</h3></div><% if (!report.teacherRows.length) { %><p class="muted">No teacher activity in this period.</p><% } else { %><div class="table-wrap"><table class="data-table"><thead><tr><th>Teacher</th><th>Students</th><th>Transactions</th><th>Awarded</th><th>Deducted</th></tr></thead><tbody><% report.teacherRows.forEach(function(row) { %><tr><td><%= row.teacher %></td><td><%= row.students %></td><td><%= row.transactions %></td><td><%= row.positivePoints %></td><td><%= row.deductions %></td></tr><% }) %></tbody></table></div><% } %></article>
      </section>
      <section class="card"><div class="report-section-heading"><span class="reporting-tool-menu-kicker">Follow-up</span><h3>Students Not Yet Recognised</h3></div><% if (!report.unrecognisedStudents.length) { %><p class="integrity-pass-copy">Every student was recognised during this period.</p><% } else { %><div class="class-student-chip-grid"><% report.unrecognisedStudents.forEach(function(row) { %><span><%= row.name %></span><% }) %></div><div class="button-row"><a class="btn" href="/teacher/reward/<%= report.classId %>">Award PITIS to this class</a></div><% } %></section>
      <section class="phase-four-two-column">
        <article class="card"><div class="report-section-heading"><span class="reporting-tool-menu-kicker">Reasons</span><h3>Common Reasons</h3></div><% if (!report.reasonRows.length) { %><p class="muted">No reasons in this period.</p><% } else { %><div class="table-wrap"><table class="data-table"><thead><tr><th>Reason</th><th>Type</th><th>Uses</th><th>Students</th><th>Net</th></tr></thead><tbody><% report.reasonRows.forEach(function(row) { %><tr><td><%= row.reason %></td><td><%= row.type %></td><td><%= row.uses %></td><td><%= row.students %></td><td><%= row.netPoints %></td></tr><% }) %></tbody></table></div><% } %></article>
        <article class="card"><div class="report-section-heading"><span class="reporting-tool-menu-kicker">Student detail</span><h3>Recognition Distribution</h3></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Student</th><th>Days</th><th>Awards</th><th>PITIS</th><th>Deductions</th></tr></thead><tbody><% report.studentRows.forEach(function(row) { %><tr><td><%= row.name %></td><td><%= row.recognitionDays %></td><td><%= row.awards %></td><td><%= row.positivePoints %></td><td><%= row.deductions %></td></tr><% }) %></tbody></table></div></article>
      </section>
    <% } %>
  </main><script src="/js/inactivity.js"></script>
</body></html>
