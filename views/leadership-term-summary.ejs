<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Leadership PITIS Term Summary</title><link rel="stylesheet" href="/css/theme-c.css"></head><body>
<%- include('partials/teacher-nav') %><main class="container stack phase-five-report-page">
  <div class="calendar-header-row report-header-row"><div><span class="reporting-tool-menu-kicker">Phase 5 · Leadership</span><h2>Leadership PITIS Term Summary</h2><p class="muted">A one-page view of SIP consistency, recognition equity, activity, and support priorities.</p></div><div class="button-row"><a class="btn secondary" href="/teacher/reporting-tool">Reporting Tool</a><a class="btn secondary" href="/teacher/reporting-tool/leadership-summary/export.csv?term=<%= report.term.term %>&asOf=<%= report.asOf %>">Download CSV</a><button class="btn" type="button" onclick="window.print()">Print / Save PDF</button></div></div>
  <form class="card form leadership-filter" method="get" action="/teacher/reporting-tool/leadership-summary"><label>Term<select name="term"><% [1,2,3,4].forEach(function(term) { %><option value="<%= term %>" <%= Number(report.term.term) === term ? 'selected' : '' %>>Term <%= term %></option><% }) %></select></label><label>Report as of<input type="date" name="asOf" value="<%= report.asOf %>" required></label><button class="btn" type="submit">Generate Summary</button></form>
  <section class="card leadership-status"><div><span class="reporting-tool-menu-kicker">Term <%= report.term.term %> · <%= report.term.start %> to <%= report.reportEnd %></span><h3><%= report.summary.sipStatus %></h3><p class="muted">SIP target: <%= report.dashboard.sipTarget.current %> of <%= report.dashboard.sipTarget.target %> required teachers currently on track. Generated <%= report.generatedAt %>.</p></div></section>
  <section class="phase-five-kpi-grid"><article class="card"><strong><%= report.summary.schoolConsistency %>%</strong><span>School consistency</span></article><article class="card"><strong><%= report.summary.teachersOnTrack %>/<%= report.summary.teachersTotal %></strong><span>Teachers on track</span></article><article class="card"><strong><%= report.summary.recognitionCoverage %>%</strong><span>Student coverage</span></article><article class="card"><strong><%= report.summary.recognisedStudents %>/<%= report.summary.students %></strong><span>Students recognised</span></article><article class="card"><strong><%= report.summary.awarded %></strong><span>PITIS awarded</span></article><article class="card"><strong><%= report.summary.deducted %></strong><span>PITIS deducted</span></article></section>
  <section class="phase-five-two-column">
    <article class="card"><div class="report-section-heading"><span class="reporting-tool-menu-kicker">Support priority</span><h3>Teacher Consistency Below 80%</h3><p class="muted">Based on completed official school weeks.</p></div><% if (!report.teacherPriorities.length) { %><p class="integrity-pass-copy">All measured teachers are at or above 80%.</p><% } else { %><div class="table-wrap"><table class="data-table"><thead><tr><th>Teacher</th><th>Consistency</th><th>Weeks met</th><th>PITIS</th></tr></thead><tbody><% report.teacherPriorities.forEach(function(row) { %><tr><td><%= row.name %></td><td><strong><%= row.consistency %>%</strong></td><td><%= row.metWeeks %>/<%= row.completedWeeks %></td><td><%= row.termPitisAwarded %></td></tr><% }) %></tbody></table></div><% } %></article>
    <article class="card"><div class="report-section-heading"><span class="reporting-tool-menu-kicker">Equity priority</span><h3>Class Coverage Below 80%</h3><p class="muted">Students receiving at least one positive PITIS during the term-to-date period.</p></div><% if (!report.classPriorities.length) { %><p class="integrity-pass-copy">All classes are at or above 80% recognition coverage.</p><% } else { %><div class="table-wrap"><table class="data-table"><thead><tr><th>Class</th><th>Coverage</th><th>Recognised</th><th>Not recognised</th></tr></thead><tbody><% report.classPriorities.forEach(function(row) { %><tr><td><%= row.name %></td><td><strong><%= row.coverage %>%</strong></td><td><%= row.recognised %>/<%= row.students %></td><td><%= row.notRecognised %></td></tr><% }) %></tbody></table></div><% } %></article>
  </section>
  <section class="card"><div class="report-section-heading"><span class="reporting-tool-menu-kicker">Trend</span><h3>Weekly Teacher Target Performance</h3></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Week</th><th>Starting</th><th>Meeting target</th><th>Needing support</th><th>Total teachers</th></tr></thead><tbody><% report.weeklyRows.forEach(function(row) { %><tr><td>Week <%= row.weekNumber %></td><td><%= row.start %></td><td><%= row.meeting %></td><td><%= row.missing %></td><td><%= row.total %></td></tr><% }) %></tbody></table></div></section>
</main><script src="/js/inactivity.js"></script></body></html>
