      function buildAdminStudentPhotoSlots(student) {
        if (!student) return [];
        return Array.from({ length: 6 }, function (_, index) {
          var slot = index + 1;
          var pathField = slot === 1 ? 'photo_path' : ('photo_' + slot + '_path');
          var uploadedAtField = slot === 1 ? 'photo_uploaded_at' : ('photo_' + slot + '_uploaded_at');
          var src = String(student[pathField] || '').trim();
          var uploadedAtRaw = String(student[uploadedAtField] || '').trim();
          return {
            slot: slot,
            src: src,
            uploadedAt: uploadedAtRaw ? uploadedAtRaw.slice(0, 10) : ''
          };
        });
      }

      function renderStudentPhotoSlots(slots) {
        if (!adminStudentPhotoSlotsWrap) return;
        var slotMap = {};
        (slots || []).forEach(function (slot) {
          slotMap[String(slot.slot)] = slot;
        });
        adminStudentPhotoSlotsWrap.querySelectorAll('[data-photo-slot]').forEach(function (node) {
          var slotId = String(node.getAttribute('data-photo-slot') || '');
          var slot = slotMap[slotId] || null;
          if (slot && slot.src) {
            node.innerHTML = '<img src="' + String(slot.src).replace(/"/g, '&quot;') + '" alt="Student photo ' + slotId + '" style="width:100%;height:100%;object-fit:cover;" />';
          } else {
            node.innerHTML = '<span class="muted" style="font-size:12px;text-align:center;padding:8px;">No photo</span>';
          }
        });
        adminStudentPhotoSlotsWrap.querySelectorAll('[data-photo-uploaded-at]').forEach(function (node) {
          var slotId = String(node.getAttribute('data-photo-uploaded-at') || '');
          var slot = slotMap[slotId] || null;
          node.textContent = slot && slot.uploadedAt ? ('Uploaded: ' + slot.uploadedAt) : 'No upload yet';
        });
      }


