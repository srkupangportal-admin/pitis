          created_at: adminUserMetaCreated ? String(adminUserMetaCreated.textContent || '').replace(/^Created:\s*/, '') : '',
          qr_code_image: adminUserQrImage ? adminUserQrImage.src : '',
          qr_code_payload: adminUserQrPayload ? adminUserQrPayload.textContent : ''
        };

        adminUsersData = (adminUsersData || []).map(function (user) {
          return Number(user.id) === Number(selectedUser.id) ? Object.assign({}, user, selectedUser) : user;
        });
        syncAdminUserPickerOption(selectedUser);
        applyAdminUserData(selectedUser);
      });

      bindAsyncDashboardForm(adminUserResetForm, function () {
        if (!adminUserResetForm) return;
        var passwordField = adminUserResetForm.querySelector('[name="new_password"]');
        if (passwordField) passwordField.value = '';
      });

      bindAsyncDashboardForm(adminStudentEditForm, function () {
        if (!adminStudentEditForm) return;
        var classField = adminStudentEditForm.querySelector('[name="class_id"]');
        var nextClassId = Number((classField && classField.value) || 0);
        if (nextClassId) {
          loadAdminClassData(nextClassId);
        }
      });

      Array.from(document.querySelectorAll('form[action^="/admin/points/reasons/"][data-async-dashboard-form]')).forEach(function (form) {
        bindAsyncDashboardForm(form);
      });

      Array.from(document.querySelectorAll('form[action^="/admin/calendar/update/"][data-async-dashboard-form]')).forEach(function (form) {
        bindAsyncDashboardForm(form, updateActiveEventRowFromForm);
      });

      bindAsyncDashboardForm(document.getElementById('adminBackupSettingsForm'));

      Array.from(document.querySelectorAll('form[action^="/admin/kiosk/reward-rules/"][data-async-dashboard-form]')).forEach(function (form) {
        bindAsyncDashboardForm(form);
      });

      if (adminUserManageBtn && adminUserPicker && adminUserEditForm && adminUserResetForm) {
        adminUserManageBtn.addEventListener('click', function () {
          var pickedId = Number(adminUserPicker.value || 0);
          var pickedUser = (adminUsersData || []).find(function (user) {
            return Number(user.id) === pickedId;
          });
          if (!pickedUser) return;
          applyAdminUserData(pickedUser);
          toggleAdminUserEditor(true);
        });
      }

      if (adminUserHideBtn) {
        adminUserHideBtn.addEventListener('click', function () {
          toggleAdminUserEditor(false);
        });
      }

      if (adminAddUserRole && adminAddUserType) {
        adminAddUserRole.addEventListener('change', function () {
          adminAddUserType.value = adminAddUserRole.value || 'teacher';
        });
      }

      if (adminAddUserForm) {
        adminAddUserForm.addEventListener('submit', function () {
          if (adminAddUserRole && adminAddUserType && !adminAddUserType.value) {
            adminAddUserType.value = adminAddUserRole.value || 'teacher';
          }
        });
      }

      if (adminInformationBulkForm) {
        function getInfoFileCheckboxes() {
          return Array.from(adminInformationBulkForm.querySelectorAll('.info-file-select'));
        }

        function setAllInfoFileCheckboxes(checked) {
          getInfoFileCheckboxes().forEach(function (checkbox) {
            checkbox.checked = !!checked;
          });
          if (toggleAllInfoFiles) toggleAllInfoFiles.checked = !!checked;
        }

        function syncBulkInfoFolderInputs() {
          if (!bulkInfoFolderSelect || !bulkInfoNewFolder) return;
          var hasFolder = String(bulkInfoFolderSelect.value || '').trim().length > 0;
          var hasNewFolder = String(bulkInfoNewFolder.value || '').trim().length > 0;
          bulkInfoFolderSelect.disabled = hasNewFolder;
          bulkInfoNewFolder.disabled = hasFolder;
        }

        if (toggleAllInfoFiles) {
          toggleAllInfoFiles.addEventListener('change', function () {
            setAllInfoFileCheckboxes(toggleAllInfoFiles.checked);
          });
        }

        if (selectAllInfoFilesBtn) {
          selectAllInfoFilesBtn.addEventListener('click', function () {
            setAllInfoFileCheckboxes(true);
          });
        }

        if (clearInfoFilesBtn) {
          clearInfoFilesBtn.addEventListener('click', function () {
            setAllInfoFileCheckboxes(false);
          });
        }

        if (bulkInfoFolderSelect && bulkInfoNewFolder) {
          bulkInfoFolderSelect.addEventListener('change', syncBulkInfoFolderInputs);
          bulkInfoNewFolder.addEventListener('input', syncBulkInfoFolderInputs);
          syncBulkInfoFolderInputs();
        }

        adminInformationBulkForm.addEventListener('submit', function (event) {
          var submitter = event.submitter;
          var action = submitter ? String(submitter.value || '') : '';
          var selectedCount = getInfoFileCheckboxes().filter(function (checkbox) { return checkbox.checked; }).length;

          if (!selectedCount) {
            event.preventDefault();
            alert('Please select at least one information file.');
            return;
          }

          if (action === 'move') {
            var hasFolder = bulkInfoFolderSelect && String(bulkInfoFolderSelect.value || '').trim().length > 0;
            var hasNewFolder = bulkInfoNewFolder && String(bulkInfoNewFolder.value || '').trim().length > 0;
            if (!hasFolder && !hasNewFolder) {
              event.preventDefault();
              alert('Please choose an existing folder or enter a new folder name.');
            }
          }
        });
      }

      var dashboardError = <%- JSON.stringify(error || '').replace(/</g, '\u003c') %>;
      var dashboardSuccess = <%- JSON.stringify(success || '').replace(/</g, '\u003c') %>;
      var shouldOpenUserManagement = /user account|user id|email|password/i.test(dashboardError) || /user account/i.test(dashboardSuccess);
      var shouldOpenBackupRestore = /backup|restore/i.test(dashboardError) || /backup|restore/i.test(dashboardSuccess);
      if (shouldOpenUserManagement) {
        toggleSimpleSection(userManagementWrap, showUserManagementBtn, hideUserManagementBtn, true);
        toggleSimpleSection(addUserFormWrap, showAddUserBtn, hideAddUserBtn, true);
      }
      if (shouldOpenBackupRestore) {
        toggleSimpleSection(backupRestoreWrap, showBackupRestoreBtn, hideBackupRestoreBtn, true);
      }
      if (adminClassPicker && adminStudentPickerForm && adminStudentEditForm) {
        adminClassPicker.addEventListener('change', function () {
          var classId = String(adminClassPicker.value || '').trim();
          toggleAdminStudentEditor(false);
          loadAdminClassData(classId, function () {
            if (adminClassPickerForm) adminClassPickerForm.submit();
          });
        });
      }

      if (pointsResetClass && adminStudentPickerForm && adminStudentEditForm) {
        pointsResetClass.addEventListener('change', function () {
          var classId = String(pointsResetClass.value || '').trim();
          loadAdminClassData(classId, function () {
            window.location = '/admin/dashboard?class_id=' + encodeURIComponent(classId);
          });
        });
      }

      if (adminStudentPicker && adminStudentPickerForm && adminStudentEditForm) {
        adminStudentPicker.addEventListener('change', function () {
          var studentPk = String(adminStudentPicker.value || '').trim();
          var classIdField = adminStudentPickerForm.querySelector('[name="class_id"]');
          var classId = classIdField ? String(classIdField.value || '').trim() : '';
          toggleAdminStudentEditor(false);
          syncStudentManageButton();
          if (!studentPk || !classId) return;

          fetch('/admin/students/' + encodeURIComponent(studentPk) + '/edit-data?class_id=' + encodeURIComponent(classId), {
            headers: { Accept: 'application/json' },
            credentials: 'same-origin'
          })
            .then(function (res) {
              if (!res.ok) throw new Error('Failed to load student details');
              return res.json();
            })
            .then(function (payload) {
              if (!payload || !payload.student) throw new Error('Student data missing');
              applyStudentEditData(payload.student);
            })
            .catch(function () {
              adminStudentPickerForm.submit();
            });
        });
      }

      if (adminStudentManageBtn && adminStudentPicker && adminStudentEditForm) {
        adminStudentManageBtn.addEventListener('click', function () {
          if (adminStudentManageBtn.disabled) return;
          toggleAdminStudentEditor(true);
        });
      }

      if (adminStudentHideBtn) {
        adminStudentHideBtn.addEventListener('click', function () {
          toggleAdminStudentEditor(false);
        });
      }

      syncStudentManageButton();

      if (staffCsvInput && staffPreviewWrap && staffPreviewBody) {
        staffCsvInput.addEventListener('change', function () {
          var file = staffCsvInput.files && staffCsvInput.files[0];
          if (!file) {
            staffPreviewWrap.style.display = 'none';
            return;
          }

          var reader = new FileReader();
          reader.onload = function () {
            var text = String(reader.result || '').trim();
            var lines = text.split(/\r?\n/).filter(Boolean);
            if (lines.length <= 1) {
              staffPreviewWrap.style.display = 'none';
              return;
            }

            var headers = lines[0].split(',').map(function (h) { return h.trim().toLowerCase(); });
            var idxUserId = headers.indexOf('user_id');
            var idxName = headers.indexOf('full_name');
            var idxEmail = headers.indexOf('email');
            var idxRole = headers.indexOf('role');
            var idxActive = headers.indexOf('is_active');

            staffPreviewBody.innerHTML = '';
            lines.slice(1, 11).forEach(function (line) {
              var cols = line.split(',').map(function (x) { return x.trim(); });
              var tr = document.createElement('tr');
              tr.innerHTML =
                '<td>' + (idxUserId >= 0 ? (cols[idxUserId] || '') : '') + '</td>' +
                '<td>' + (idxName >= 0 ? (cols[idxName] || '') : '') + '</td>' +
                '<td>' + (idxEmail >= 0 ? (cols[idxEmail] || '') : '') + '</td>' +
                '<td>' + (idxRole >= 0 ? (cols[idxRole] || '') : 'teacher') + '</td>' +
                '<td>' + (idxActive >= 0 ? (cols[idxActive] || '') : 'true') + '</td>';
              staffPreviewBody.appendChild(tr);
            });
            staffPreviewWrap.style.display = 'block';
          };
          reader.readAsText(file);
        });
      }
    })();
  </script>

  <script src="/js/inactivity.js"></script>
</body>
</html>








