      function renderStudentPickerOptions(students, selectedStudentId) {
        if (!adminStudentPicker) return;
        adminStudentPicker.innerHTML = '';
        if (!students || !students.length) {
          var emptyOpt = document.createElement('option');
          emptyOpt.value = '';
          emptyOpt.textContent = 'No students in class';
          adminStudentPicker.appendChild(emptyOpt);
          adminStudentPicker.disabled = true;
          syncStudentManageButton();
          return;
        }

        students.forEach(function (student) {
          var opt = document.createElement('option');
          opt.value = String(student.id);
          opt.textContent = String(student.nickname || '') + ' - ' + String(student.full_name || '');
          opt.selected = Number(student.id) === Number(selectedStudentId);
          adminStudentPicker.appendChild(opt);
        });
        adminStudentPicker.disabled = false;
        syncStudentManageButton();
