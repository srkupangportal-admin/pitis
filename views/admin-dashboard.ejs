      function loadAdminClassData(classId, onError) {
        if (!classId) return;

        var hiddenClassField = adminStudentPickerForm ? adminStudentPickerForm.querySelector('[name="class_id"]') : null;
        if (hiddenClassField) hiddenClassField.value = classId;
        if (adminClassPicker) adminClassPicker.value = classId;
        if (pointsResetClass) pointsResetClass.value = classId;

        fetch('/admin/classes/' + encodeURIComponent(classId) + '/edit-data', {
          headers: { Accept: 'application/json' },
          credentials: 'same-origin'
        })
          .then(function (res) {
            if (!res.ok) throw new Error('Failed to load class data');
            return res.json();
          })
          .then(function (payload) {
            var students = payload && payload.students ? payload.students : [];
            var selectedStudent = payload ? payload.selectedStudent : null;
            renderStudentPickerOptions(students, selectedStudent ? selectedStudent.id : null);
            renderPointsStudentOptions(students);
            if (selectedStudent) {
              applyStudentEditData(selectedStudent);
