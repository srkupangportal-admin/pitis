<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Reminders</title><link rel="stylesheet" href="/css/theme-c.css"></head><body><%- include('partials/main-header-card') %><main class="container"><section class="card form"><h2>Assign a reminder</h2><form method="post" action="/reminders"><label>Title<input required name="title"></label><label>Details<textarea name="details"></textarea></label><label>Due date and time<input type="datetime-local" name="due_at"></label><label>Assign to<select required name="assigned_to"><% staff.forEach(function(user){ %><option value="<%= user.id %>"><%= user.display_name %> · <%= user.role %></option><% }) %></select></label><button class="btn">Assign reminder</button></form></section><section class="card"><h2>Reminders</h2><% if(!items.length){ %><p class="muted">No reminders yet.</p><% } %><% items.forEach(function(item){ %><article class="notification-item <%= item.status==='open'?'unread':'' %>" id="reminder-<%= item.id %>"><strong><%= item.title %></strong><span><%= item.details || '' %></span><small>Assigned to <%= item.assigned_name %><%= item.due_at?' · Due '+item.due_at:'' %> · <%= item.status %></small><% if(item.status==='open'){ %><form method="post" action="/reminders/<%= item.id %>/complete"><button class="btn secondary">Mark complete</button></form><% } %></article><% }) %></section></main></body></html>
