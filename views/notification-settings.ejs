<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Notification Settings</title><link rel="stylesheet" href="/css/theme-c.css"></head><body><%- include('partials/main-header-card') %><main class="container"><section class="card"><h2>Notification Settings</h2><p id="pushStatus" class="muted">Checking this device…</p><button class="btn" id="enablePush">Enable notifications on this device</button><h3>Preferences</h3><form id="preferences" class="notification-preferences"></form><h3>Registered devices</h3><div id="devices"></div></section></main><script src="/js/notifications.js"></script><script>const keys={calendar_tag:'When I am tagged in a calendar event',calendar_event_time:'At event time',calendar_15_minutes:'15 minutes before',calendar_1_hour:'1 hour before',calendar_1_day:'1 day before',reminder_assigned:'New reminder assigned',reminder_due_soon:'Reminder due soon',reminder_overdue:'Overdue reminder'};async function load(){const [prefs,devices]=await Promise.all([PortalNotifications.json('/api/notification-preferences'),PortalNotifications.json('/api/push/subscriptions')]),form=document.getElementById('preferences');form.innerHTML='';Object.entries(keys).forEach(([key,label])=>{const item=document.createElement('label');item.className='notification-option';item.innerHTML='<input type="checkbox"><span></span>';item.querySelector('input').checked=!!prefs[key];item.querySelector('input').onchange=()=>PortalNotifications.json('/api/notification-preferences',{method:'PATCH',body:JSON.stringify({[key]:item.querySelector('input').checked})});item.querySelector('span').textContent=label;form.appendChild(item)});const box=document.getElementById('devices');box.innerHTML=devices.length?'':'No registered devices.';devices.forEach(device=>{const row=document.createElement('div');row.className='notification-device';row.innerHTML='<span></span><button class="btn secondary">Remove</button>';row.querySelector('span').textContent=device.device_name||'Browser device';row.querySelector('button').onclick=async()=>{await PortalNotifications.json('/api/push/subscriptions/'+device.id,{method:'DELETE'});load()};box.appendChild(row)});document.getElementById('pushStatus').textContent=Notification.permission==='granted'?'Browser permission granted.':'Push notifications are not enabled on this device.'}document.getElementById('enablePush').onclick=async()=>{try{await PortalNotifications.enable();await load()}catch(error){document.getElementById('pushStatus').textContent=error.message}};load()</script></body></html>
