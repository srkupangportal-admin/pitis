<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Notification Settings</title>
  <link rel="stylesheet" href="/css/theme-c.css">
</head>
<body>
  <%- include('partials/main-header-card') %>
  <main class="container"><section class="card">
    <h2>Notification Settings</h2>
    <p id="pushStatus" class="muted">Checking this device…</p>
    <div id="iosInstallSteps" class="notification-install-guide" hidden>
      <strong>Install PITIS on iPhone or iPad</strong>
      <ol><li>Tap the browser's <b>Share</b> button.</li><li>Choose <b>Add to Home Screen</b>.</li><li>Tap <b>Add</b>, then close the browser.</li><li>Open <b>PITIS</b> from its new Home Screen icon.</li><li>Return here and tap <b>Enable notifications</b>.</li></ol>
      <p class="muted">Requires iOS or iPadOS 16.4 or newer. Chrome and Safari use the same Home Screen process.</p>
    </div>
    <div class="button-row"><button class="btn" id="enablePush">Enable notifications on this device</button><button class="btn secondary" id="testPush" hidden>Send test notification</button></div>
    <h3>Preferences</h3>
    <form id="preferences" class="notification-preferences"></form>
    <h3>Registered devices</h3>
    <div id="devices"></div>
  </section></main>
  <script src="/js/notifications.js"></script>
  <script>
    const keys = {
      calendar_tag: 'When I am tagged in a calendar event',
      calendar_5_days: '5 days before an event',
      calendar_3_days: '3 days before an event',
      calendar_event_time: 'On the event day',
      reminder_assigned: 'New reminder assigned',
      reminder_due_soon: 'Reminder due soon',
      reminder_overdue: 'Overdue reminder',
      pitis_progress: 'PITIS progress and weekly summaries',
      pitis_0930_reminder: '9:30 AM reminder when I have not awarded PITIS',
      pitis_first_award: 'First PITIS award congratulations and school announcement'
    };

    async function load() {
      const [prefs, devices] = await Promise.all([
        PortalNotifications.json('/api/notification-preferences'),
        PortalNotifications.json('/api/push/subscriptions')
      ]);
      const form = document.getElementById('preferences');
      form.innerHTML = '';
      Object.entries(keys).forEach(([key, label]) => {
        const item = document.createElement('label');
        item.className = 'notification-option';
        item.innerHTML = '<input type="checkbox"><span></span>';
        item.querySelector('input').checked = !!prefs[key];
        item.querySelector('input').onchange = () => PortalNotifications.json('/api/notification-preferences', {
          method: 'PATCH',
          body: JSON.stringify({ [key]: item.querySelector('input').checked })
        });
        item.querySelector('span').textContent = label;
        form.appendChild(item);
      });
      const box = document.getElementById('devices');
      box.innerHTML = devices.length ? '' : 'No registered devices.';
      devices.forEach(device => {
        const row = document.createElement('div');
        row.className = 'notification-device';
        row.innerHTML = '<span></span><button class="btn secondary">Remove</button>';
        row.querySelector('span').textContent = device.device_name || 'Browser device';
        row.querySelector('button').onclick = async () => {
          await PortalNotifications.json('/api/push/subscriptions/' + device.id, { method: 'DELETE' });
          load();
        };
        box.appendChild(row);
      });
      const status = document.getElementById('pushStatus');
      const button = document.getElementById('enablePush');
      const testButton = document.getElementById('testPush');
      const guide = document.getElementById('iosInstallSteps');
      const push = await PortalNotifications.status().catch(() => PortalNotifications.guidance());
      status.textContent = push.message;
      status.dataset.state = push.state;
      guide.hidden = push.state !== 'install-required';
      button.hidden = push.state === 'install-required';
      button.disabled = !push.canEnable;
      button.textContent = push.state === 'permission-only' ? 'Repair notification subscription' : 'Enable notifications on this device';
      testButton.hidden = push.state !== 'enabled';
    }

    document.getElementById('enablePush').onclick = async () => {
      try {
        await PortalNotifications.enable();
        await load();
      } catch (error) {
        document.getElementById('pushStatus').textContent = error.message;
      }
    };
    document.getElementById('testPush').onclick = async () => {
      const button = document.getElementById('testPush');
      button.disabled = true;
      try {
        await PortalNotifications.json('/api/notifications/test', { method: 'POST', body: '{}' });
        document.getElementById('pushStatus').textContent = 'Test sent. It should appear shortly; lock the screen or leave PITIS open in the background if needed.';
      } catch (error) {
        document.getElementById('pushStatus').textContent = error.message;
      } finally { setTimeout(() => { button.disabled = false; }, 30000); }
    };
    load();
  </script>
</body>
</html>
