<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>PWA and Notification Adoption</title><link rel="stylesheet" href="/css/theme-c.css"></head><body>
<%- include('partials/teacher-nav') %><main class="container stack phase-five-report-page">
  <div class="calendar-header-row report-header-row"><div><span class="reporting-tool-menu-kicker">Phase 5 · Adoption</span><h2>PWA and Notification Adoption</h2><p class="muted">Track invitations, push-enabled devices, recorded P.I.T.I.S usage, QR scans, and mobile transactions.</p></div><div class="button-row"><a class="btn secondary" href="/teacher/reporting-tool">Reporting Tool</a><a class="btn secondary" href="/teacher/reporting-tool/pwa-adoption/export.csv">Download CSV</a><button class="btn" type="button" onclick="window.print()">Print / Save PDF</button></div></div>
  <section class="card adoption-note"><strong>Measurement boundary</strong><p>The server cannot reliably detect whether a browser installed the PWA. “Opened PWA,” QR scans, and PWA transactions are measured from this reporting release onward. Push-enabled devices are measured independently.</p></section>
  <section class="phase-five-kpi-grid"><article class="card"><strong><%= report.summary.invited %>/<%= report.summary.users %></strong><span>Users invited</span></article><article class="card"><strong><%= report.summary.pushEnabled %></strong><span>Push-enabled users</span></article><article class="card"><strong><%= report.summary.activeDevices %></strong><span>Active push devices</span></article><article class="card"><strong><%= report.summary.pwaOpened %></strong><span>PWA users recorded</span></article><article class="card"><strong><%= report.summary.pwaTransactions %></strong><span>PWA transactions</span></article><article class="card"><strong><%= report.summary.scans %></strong><span>Successful QR scans</span></article></section>
  <section class="card"><div class="report-section-heading"><span class="reporting-tool-menu-kicker">Users</span><h3>Adoption Status</h3><p class="muted">Generated <%= report.generatedAt %>.</p></div><div class="table-wrap"><table class="data-table"><thead><tr><th>User</th><th>Status</th><th>Invites</th><th>Push devices</th><th>PWA last used</th><th>Views</th><th>QR scans</th><th>Transactions</th><th>Last class</th></tr></thead><tbody><% report.users.forEach(function(row) { %><tr><td><strong><%= row.name %></strong><br><small class="muted"><%= row.username %> · <%= row.role %></small></td><td><span class="status-badge"><%= row.status %></span></td><td><%= row.inviteCount %><br><small class="muted"><%= row.lastInvitedAt %></small></td><td><%= row.activeDevices %></td><td><%= row.pwaLastSeenAt %></td><td><%= row.pageViews %></td><td><%= row.scanCount %></td><td><%= row.pwaTransactions %></td><td><%= row.lastClassName %></td></tr><% }) %></tbody></table></div></section>
  <section class="card"><div class="report-section-heading"><span class="reporting-tool-menu-kicker">Delivery diagnostics</span><h3>Push Delivery Log</h3><p class="muted">Historical delivery attempts across all notification types.</p></div><% if (!report.deliveryRows.length) { %><p class="muted">No delivery attempts recorded.</p><% } else { %><div class="adoption-delivery-grid"><% report.deliveryRows.forEach(function(row) { %><div><strong><%= row.total %></strong><span><%= row.status %></span></div><% }) %></div><% } %></section>
</main><script src="/js/inactivity.js"></script></body></html>
