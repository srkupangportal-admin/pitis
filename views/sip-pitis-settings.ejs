<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SIP PITIS Settings</title>
  <link rel="stylesheet" href="/css/theme-c.css" />
</head>
<body>
  <%- include('partials/teacher-nav') %>
  <main class="container stack sip-pitis-page">
    <div class="calendar-header-row report-header-row">
      <div>
        <span class="reporting-tool-menu-kicker">Admin settings</span>
        <h2>School PITIS Term Targets</h2>
        <p class="muted">Set the school target separately for each term and choose the teacher accounts included in measurement.</p>
      </div>
      <div class="report-actions">
        <a class="btn secondary" href="/teacher/reporting-tool/sip-pitis">Dashboard</a>
        <a class="btn secondary" href="/teacher/reporting-tool">Reporting Tool</a>
        <a class="btn secondary" href="/teacher/reporting-tool/sip-pitis/export.csv">Excel CSV</a>
        <button class="btn" type="button" onclick="window.print()">PDF / Print</button>
      </div>
    </div>

    <% if (saved) { %><div class="success-message">SIP PITIS settings saved.</div><% } %>
    <% if (error) { %><div class="card target-settings-error"><strong>Settings were not saved.</strong><p><%= error %></p></div><% } %>

    <form class="card form stack" method="post" action="/teacher/reporting-tool/sip-pitis/settings">
      <section>
        <h3>Term-by-term school targets</h3>
        <p class="muted">The denominator is the total number of teachers used for the school target. Each term target is the number expected to remain on track. The percentage is calculated automatically.</p>
        <div class="sip-settings-grid">
          <label>Target denominator
            <input type="number" min="1" name="teacher_target_total" id="teacherTargetTotal" value="<%= settings.teacherTargetTotal %>" required />
            <small class="muted">Total teachers in the target, for example 18.</small>
          </label>
          <% [1,2,3,4].forEach(function(term) { %>
            <label>Term <%= term %>
              <input class="term-target-input" type="number" min="0" max="<%= settings.teacherTargetTotal %>" name="target_term_<%= term %>" value="<%= settings.termTargets[term] %>" data-term="<%= term %>" required />
              <small class="muted" data-term-percentage="<%= term %>"><%= settings.teacherTargetTotal ? Math.round((settings.termTargets[term] / settings.teacherTargetTotal) * 100) : 0 %>% of target teachers</small>
            </label>
          <% }) %>
        </div>
      </section>

      <section>
        <h3>Excluded Accounts</h3>
        <label>Excluded usernames
          <input type="text" name="excluded_usernames" value="<%= settings.excludedUsernames.join(', ') %>" />
        </label>
      </section>

      <section>
        <h3>Teacher Accounts</h3>
        <p class="muted">Select portal accounts that count as teachers in the SIP PITIS dashboard.</p>
        <div class="sip-teacher-select-grid">
          <% var selected = new Set(settings.selectedTeacherIds || candidates.map(function(candidate) { return candidate.id; })); %>
          <% candidates.forEach(function(candidate) { %>
            <label class="reward-tile pitis-usage-user-card <%= selected.has(candidate.id) ? 'selected' : '' %>">
              <input type="checkbox" name="teacher_user_ids" value="<%= candidate.id %>" <%= selected.has(candidate.id) ? 'checked' : '' %> />
              <strong><%= candidate.display_name %></strong>
              <span class="muted"><%= candidate.username %> · <%= candidate.user_type %></span>
            </label>
          <% }) %>
        </div>
      </section>

      <div class="reward-bulk-actions">
        <button class="btn" type="submit">Save Settings</button>
      </div>
    </form>
  </main>
  <script>
    (function () {
      var denominator = document.getElementById('teacherTargetTotal');
      var targets = Array.prototype.slice.call(document.querySelectorAll('.term-target-input'));
      function updatePercentages() {
        var total = Math.max(1, Number(denominator && denominator.value) || 1);
        targets.forEach(function (input) {
          input.max = String(total);
          var output = document.querySelector('[data-term-percentage="' + input.dataset.term + '"]');
          if (output) output.textContent = Math.round(((Number(input.value) || 0) / total) * 100) + '% of target teachers';
        });
      }
      if (denominator) denominator.addEventListener('input', updatePercentages);
      targets.forEach(function (input) { input.addEventListener('input', updatePercentages); });
      updatePercentages();
    })();
  </script>
  <script src="/js/inactivity.js"></script>
</body>
</html>
