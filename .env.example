# Core server
HOST=0.0.0.0
HTTP_ENABLED=false
HTTP_PORT=3000
HTTPS_PORT=3443
HTTPS_ENABLED=true
REDIRECT_HTTP_TO_HTTPS=true

# Optional LAN identity shown in logs and deployment docs
PUBLIC_IP=192.168.1.50
PUBLIC_HOSTNAME=school-portal.local

# SSL certificate files for LAN HTTPS
# Keep the certs folder beside srkupangPORTAL in the main schoolserver folder.
# Relative paths are always resolved from this project folder, regardless of
# the folder from which the Windows start command is run.
SSL_KEY_PATH=../certs/school-portal/server.key
SSL_CERT_PATH=../certs/school-portal/server.crt
# Optional internal CA / chain file
SSL_CA_PATH=../certs/school-portal/ca.crt

# Session / proxy
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long
SECURE_COOKIES=true
TRUST_PROXY=false

# Classroom Compass address shown on the public P.I.T.I.S leaders page
CLASS_COMPASS_URL=http://127.0.0.1:4173

# Protected endpoint used by Classroom Compass to award P.I.T.I.S. for handed-in assignments.
CLASSCOMPASS_INTEGRATION_TOKEN=replace-with-the-same-long-random-value-used-by-classcompass
